# Copy this file to `.env` (which is gitignored) and fill in your keys.
# The concrescence example auto-loads `.env` from cwd via dotenvy at startup.
#
#   cp .env.example .env
#   $EDITOR .env
#   cargo run --example concrescence --features runaway-hackathon -- frames/frame_0000.png

# Anthropic — Claude vision (image + OCR + EXIF → unified caption)
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-sonnet-4-6)
# LUX_VISION_MODEL=claude-opus-4-7

# Runway — image_to_video (frame as init, caption as guide → queued video task)
RUNWAY_API_KEY=key_...
# Optional model override. Default: gen4_turbo (image-conditioned).
# Use veo3.1_fast (or another text-only model) ONLY if you patch main()
# back to text_to_video — image_to_video requires an image-conditioned model.
# LUX_VIDEO_MODEL=gen4_turbo
# Optional base URL override (default: https://api.dev.runwayml.com)
# LUX_RUNWAY_BASE_URL=https://api.dev.runwayml.com
# Optional duration override in seconds (default: 4). Runway accepts only
# discrete values per model — typically {4, 8} for veo3.1_fast, {5, 10}
# for some gen4_turbo configs. 400 = "try a neighbor."
# LUX_VIDEO_DURATION_SECS=8
